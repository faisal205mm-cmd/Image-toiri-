rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSaleRecord(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             (!('paidAmount' in data) || data.paidAmount is number) &&
             (!('dueAmount' in data) || data.dueAmount is number) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() > 0));
    }

    function isValidMonthlyFinance(data) {
      return data.type in ['INCOME', 'EXPENSE'] &&
             data.title is string && data.title.size() > 0 &&
             data.amount is number && data.amount >= 0 &&
             (!('userId' in data) || (data.userId is string && data.userId.size() > 0));
    }

    // Sales Records Collection
    match /sales_records/{invoiceId} {
      allow read: if isSignedIn() && (
        !('userId' in existing()) || existing().userId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidSaleRecord(incoming()) && (
        !('userId' in incoming()) || incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidSaleRecord(incoming()) && (
        !('userId' in existing()) || existing().userId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        !('userId' in existing()) || existing().userId == request.auth.uid
      );
    }

    // Monthly Finances Collection
    match /monthly_finances/{financeId} {
      allow read: if isSignedIn() && (
        !('userId' in existing()) || existing().userId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidMonthlyFinance(incoming()) && (
        !('userId' in incoming()) || incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidMonthlyFinance(incoming()) && (
        !('userId' in existing()) || existing().userId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        !('userId' in existing()) || existing().userId == request.auth.uid
      );
    }
  }
}
